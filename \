## 🚢 Production Integration

### With Viem/Wagmi (TypeScript)

```typescript
import { TransactionBuilder } from '@multicall-scripting/sdk';
import { createPublicClient, http } from 'viem';
import { mainnet } from 'viem/chains';

const builder = new TransactionBuilder();
const client = createPublicClient({
  chain: mainnet,
  transport: http()
});

// Build complex transaction
const strategy = builder
  .addCall(ERC20_ABI, USDC, 'balanceOf', [user])
  .addCall(UNISWAP_ABI, ROUTER, 'swapExactTokensForTokens', [/*...*/])
  .build();

// Execute via MulticallScripter contract
const hash = await client.writeContract({
  address: MULTICALL_SCRIPTER_ADDRESS,
  abi: MULTICALL_SCRIPTER_ABI,
  functionName: 'execute',
  args: [strategy.targets, strategy.offsets, strategy.calldatas, strategy.msgValues],
});
```

