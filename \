### Basic Example: ERC20 Balance → Transfer

```javascript
const { TransactionBuilder } = require("./js/index.js");

const builder = new TransactionBuilder();

// Get token balance - returns a virtual output for the return value
const balance = builder.addCall(
  ERC20_ABI,
  tokenAddress,
  "balanceOf",
  [userAddress],
  0n  // msg.value
);

// Transfer exact balance using the virtual output as input
builder.addCall(
  ERC20_ABI,
  tokenAddress,
  "transfer",
  [recipientAddress, balance],  // balance descriptor used as amount
  0n
);

// Build and execute
const { targets, offsets, calldatas, msgValues } = builder.build();
await multicallScripter.execute(targets, offsets, calldatas, msgValues);
```

### Foundry Test Example
There is a solidity library to work with the multicall scripter inside of foundry environment
```solidity
// test/DeFiStrategy.t.sol
import {CallBuilder, Scripter} from "src/CallBuilder.sol";

contract DeFiStrategyTest is CallBuilder, Scripter {
    function testComplexSwap() public {
        // 1. Get WETH balance
        uint256 balanceCall = call_static(
            weth,
            abi.encodeCall(IERC20.balanceOf, (address(this)))
        );
        
        // 2. Swap exact WETH for USDC
        uint256 swapCall = call_static(
            uniswapRouter,
            abi.encodeCall(
                IUniswapV2Router.swapExactTokensForTokens,
                (0, 0, path, address(this), block.timestamp) // 0 = placeholder
            )
        );
        
        // 3. Deposit USDC to Aave
        uint256 depositCall = call(
            aavePool,
            abi.encodeCall(IPool.deposit, (usdc, 0, address(this), 0)), // 0 = placeholder
            0
        );
        
        // Chain: balance → swap amount → deposit amount
        useCallOutput(balanceCall.first(), swapCall.second());  // balance → swap amount
        useCallOutput(swapCall.first(), depositCall.second());  // swap output → deposit amount
        
        // Execute atomically
        (address[] memory targets, uint256[] memory offsets, 
         bytes[] memory calldatas, uint256[] memory values) = build();
        multicallScripter.execute(targets, offsets, calldatas, values);
    }
}
```

