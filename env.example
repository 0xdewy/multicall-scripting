# Optional settings supplied to the caller's environment. deploy.sh does not source this file.
# Pass the destination RPC explicitly: script/deploy.sh RPC_URL [forge options].
# Use forge --account or --ledger for live signing; a private key is not required for dry-runs.
DEPLOY_7702=false

# Fork tests and script/rehearse.sh. This can be a public RPC or your own archive endpoint.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Set a block to reproduce a particular run; historical blocks require an archive endpoint.
# FORK_BLOCK=...
