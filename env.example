# Copy this file to .env and fill in your values before deploying.
# The deploy.sh script sources .env automatically.

# Deployer private key (with 0x prefix)
PRIVATE_KEY=0x

# Set to true to actually broadcast transactions; false (default) runs a dry-run
BROADCAST=false

# Set to true to also deploy SevenSevenZeroTwoCaller alongside MulticallScripter
DEPLOY_7702=false

# ERC-4337 EntryPoint address (v0.7, same on all chains)
ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# RPC URLs — leave blank to skip that chain
ETH_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
BLAST_RPC_URL=
LINEA_RPC_URL=
SCROLL_RPC_URL=
ZORA_RPC_URL=
